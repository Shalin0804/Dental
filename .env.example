# ---------- Backend (apps/backend/.env) ----------
NODE_ENV=development
PORT=4000
# Public URL of the frontend (CORS origin, links in emails, sitemap)
APP_URL=http://localhost:5173
# Extra allowed CORS origins, comma separated (e.g. Vercel preview URLs)
CORS_ORIGINS=

# docker compose up -d  → Postgres on 5433
DATABASE_URL=postgresql://smile:smile_dev_password@localhost:5433/smile_dental

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Seed
SEED_ADMIN_EMAIL=admin@smiledental.example
SEED_ADMIN_PASSWORD=
# Adds demo doctors / receptionist / patient (development only)
SEED_DEMO=true

# File uploads (X-rays, reports) — stored on local disk under UPLOAD_DIR, served only through the authorised API
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---------- Integrations (each is disabled until set; deliveries are logged as SKIPPED) ----------
# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<api-host>/api/payments/webhook  events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys (EMAIL_FROM must be on a verified domain)
RESEND_API_KEY=
EMAIL_FROM="Smile Dental Care <care@yourdomain.com>"

# WhatsApp Business Cloud API — templates must be approved in Meta Business Manager (see docs/INTEGRATIONS.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en

# SMS gateway (JSON POST: { to, sender, message } with Bearer auth) — see docs/INTEGRATIONS.md
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---------- Frontend (apps/frontend/.env) ----------
# Leave unset in dev (Vite proxies /api). In production: https://api.yourdomain.com/api
VITE_API_URL=
